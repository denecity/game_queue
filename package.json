{
  "name": "game-queue",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.functions.json && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev --proxy 5173",
    "cron:deploy": "wrangler deploy --config workers/price-cron/wrangler.toml",
    "db:migrate": "wrangler d1 execute gamequeue-db --remote --file=./migrations/0002_prices_images_settings.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name games --branch master --commit-dirty=true",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name games --branch preview --commit-dirty=true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.2",
    "wrangler": "^3.89.0"
  }
}
